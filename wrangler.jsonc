{
  // The docs site and its contact form. Build the folder first: npm run deploy:build (npm run deploy does both).
  // Secrets are never committed: set RESEND_API_KEY and CONTACT_TO with `wrangler secret put`.
  "name": "cieo",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // The public address. The zone must be in this Cloudflare account; the DNS record is created on deploy.
  "routes": [{ "pattern": "cieo.meridianproject.studio", "custom_domain": true }],
  "assets": {
    "directory": ".deploy",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only the form endpoint runs code; every other path is served straight from the assets.
    "run_worker_first": ["/api/*"]
  },
  // Messages are sent from the domain verified with Resend; without this variable the sandbox sender is used.
  "vars": { "CONTACT_FROM": "Cieo <hello@meridianproject.studio>" },
  "ratelimits": [
    { "name": "CONTACT_LIMITER", "namespace_id": "424201", "simple": { "limit": 3, "period": 60 } }
  ]
}
