{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cieo theme configuration v1",
  "description": "Structure only. The runtime also limits dimensions to 10000 and audits semantic color contrast.",
  "type": "object",
  "required": [
    "version",
    "options"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brand": {
          "enum": [
            "studio",
            "iris",
            "lagoon",
            "ember",
            "rose",
            "mono"
          ]
        },
        "scheme": {
          "enum": [
            "light",
            "dark"
          ]
        },
        "density": {
          "enum": [
            "compact",
            "comfortable",
            "spacious"
          ]
        },
        "radius": {
          "enum": [
            "crisp",
            "soft",
            "round"
          ]
        },
        "contrast": {
          "enum": [
            "standard",
            "high"
          ]
        },
        "font": {
          "enum": [
            "system",
            "humanist",
            "mono"
          ]
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "overrides": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "color-canvas": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "color-surface": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "color-raised": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "color-sunken": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "color-text": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "color-muted": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "color-subtle": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "color-border": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "color-border-strong": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "color-accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "color-on-accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "color-accent-hover": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "color-accent-soft": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "color-on-accent-soft": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "color-focus": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "color-selection": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "color-shadow": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "color-success": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "color-success-soft": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "color-warning": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "color-warning-soft": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "color-danger": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "color-danger-soft": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "color-info": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "color-info-soft": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
