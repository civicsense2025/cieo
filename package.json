    "check:catalogue": "node scripts/check-catalogue-inventory.mjs --check",
    "check": "bash scripts/check-brand.sh && npm run test && npm run check:design && npm run test:design:types && node scripts/wire-primitives.mjs --check && node scripts/build-component-pages.mjs --check && git diff --exit-code -- dist design/themes.css design/theme.schema.json",
    "test:browser": "python3 test/browser/smoke.py",
    "prepare": "node scripts/build-design.mjs",
    "prepack": "node scripts/build-design.mjs",
    "build:design": "node scripts/build-design.mjs",
    "build:pages": "node scripts/wire-primitives.mjs && node scripts/build-component-pages.mjs && node scripts/build-component-index.mjs",
