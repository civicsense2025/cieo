{
  "name": "cieo",
  "version": "0.1.0",
  "description": "Critically damped spring motion for web (DOM and React) and SwiftUI, with the Motion Atoms recipes.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "./tokens/*.css"
  ],
  "files": [
    "dist",
    "tokens",
    "atoms/web",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/spring.d.ts",
      "default": "./dist/core/spring.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "default": "./dist/dom/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./live": {
      "types": "./dist/live/index.d.ts",
      "default": "./dist/live/index.js"
    },
    "./tokens.css": "./tokens/tokens.css",
    "./tokens.json": "./tokens/tokens.json",
    "./atoms/*": "./atoms/web/*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "bash scripts/check-brand.sh && npm run test && git diff --exit-code -- dist",
    "test:browser": "python3 test/browser/smoke.py"
  }
}
