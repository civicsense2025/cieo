{
  "name": "cieo",
  "version": "0.3.0",
  "description": "Critically damped spring motion for web (DOM and React) and SwiftUI, with the Motion Atoms recipes.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/controls/*.css",
    "./tokens/*.css"
  ],
  "files": [
    "dist",
    "tokens",
    "atoms/web",
    "README.md",
    "design",
    "scripts/export-theme.mjs",
    "docs/design-system.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/spring.d.ts",
      "default": "./dist/core/spring.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "default": "./dist/dom/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./live": {
      "types": "./dist/live/index.d.ts",
      "default": "./dist/live/index.js"
    },
    "./controls": {
      "types": "./dist/controls/index.d.ts",
      "default": "./dist/controls/index.js"
    },
    "./controls.css": "./dist/controls/controls.css",
    "./tokens.css": "./tokens/tokens.css",
    "./tokens.json": "./tokens/tokens.json",
    "./atoms/*": "./atoms/web/*",
    "./design": {
      "types": "./design/index.d.ts",
      "default": "./design/index.js"
    },
    "./design.css": "./design/themes.css",
    "./primitives.css": "./design/primitives.css",
    "./ButtonGroup": { "types": "./dist/primitives/ButtonGroup/ButtonGroup.d.ts", "default": "./dist/primitives/ButtonGroup/ButtonGroup.js" },
    "./AvatarGroup": { "types": "./dist/primitives/AvatarGroup/AvatarGroup.d.ts", "default": "./dist/primitives/AvatarGroup/AvatarGroup.js" },
    "./IconButton": { "types": "./dist/primitives/IconButton/IconButton.d.ts", "default": "./dist/primitives/IconButton/IconButton.js" },
    "./Toolbar": { "types": "./dist/primitives/Toolbar/Toolbar.d.ts", "default": "./dist/primitives/Toolbar/Toolbar.js" },
    "./Badge": { "types": "./dist/primitives/Badge/Badge.d.ts", "default": "./dist/primitives/Badge/Badge.js" },
    "./Text": { "types": "./dist/primitives/Text/Text.d.ts", "default": "./dist/primitives/Text/Text.js" },
    "./Field": { "types": "./dist/primitives/Field/Field.d.ts", "default": "./dist/primitives/Field/Field.js" },
    "./Slider": { "types": "./dist/primitives/Slider/Slider.d.ts", "default": "./dist/primitives/Slider/Slider.js" },
    "./Stack": { "types": "./dist/primitives/Stack/Stack.d.ts", "default": "./dist/primitives/Stack/Stack.js" },
    "./Divider": { "types": "./dist/primitives/Divider/Divider.d.ts", "default": "./dist/primitives/Divider/Divider.js" },
    "./Breadcrumbs": { "types": "./dist/primitives/Breadcrumbs/Breadcrumbs.d.ts", "default": "./dist/primitives/Breadcrumbs/Breadcrumbs.js" },
    "./BreadcrumbItem": { "types": "./dist/primitives/BreadcrumbItem/BreadcrumbItem.d.ts", "default": "./dist/primitives/BreadcrumbItem/BreadcrumbItem.js" },
    "./Tooltip": { "types": "./dist/primitives/Tooltip/Tooltip.d.ts", "default": "./dist/primitives/Tooltip/Tooltip.js" },
    "./Overlay": { "types": "./dist/primitives/Overlay/Overlay.d.ts", "default": "./dist/primitives/Overlay/Overlay.js" },
    "./List": { "types": "./dist/primitives/List/List.d.ts", "default": "./dist/primitives/List/List.js" },
    "./ListItem": { "types": "./dist/primitives/ListItem/ListItem.d.ts", "default": "./dist/primitives/ListItem/ListItem.js" },
    "./Spinner": { "types": "./dist/primitives/Spinner/Spinner.d.ts", "default": "./dist/primitives/Spinner/Spinner.js" },
    "./ProgressBar": { "types": "./dist/primitives/ProgressBar/ProgressBar.d.ts", "default": "./dist/primitives/ProgressBar/ProgressBar.js" },
    "./primitives": { "types": "./dist/primitives/index.d.ts", "default": "./dist/primitives/index.js" },
    "./design.tokens.json": "./design/generated/default.tokens.json",
    "./design.portable.json": "./design/generated/default.portable.json",
    "./theme.schema.json": "./design/theme.schema.json",
    "./themes/*": "./design/generated/themes/*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && cp src/controls/controls.css dist/controls/controls.css",
    "test": "npm run build && node --test test/*.test.mjs",
    "check:catalogue": "node scripts/check-catalogue-inventory.mjs --check",
    "check": "bash scripts/check-brand.sh && npm run test && npm run check:design && npm run test:design:types && git diff --exit-code -- dist design/themes.css design/theme.schema.json",
    "test:browser": "python3 test/browser/smoke.py",
    "prepare": "node scripts/build-design.mjs",
    "prepack": "node scripts/build-design.mjs",
    "build:design": "node scripts/build-design.mjs",
    "check:design": "node scripts/build-design.mjs --check && node scripts/check-design-ledger.mjs",
    "test:design": "node --test test/design-*.test.mjs",
    "test:design:types": "tsc -p test/types/tsconfig.json",
    "test:design:browser": "python3 test/browser/design_smoke.py",
    "studio": "node scripts/serve-studio.mjs",
    "studio:standalone": "node scripts/build-standalone.mjs"
  },
  "bin": {
    "cieo-theme": "scripts/export-theme.mjs"
  }
}
